<%- include('partials/head') %>
<h2 class="bubble s" data-bubble="Register"></h2>
<form class="card form" method="post" action="/register">
  <% if (err) { %><p class="toast bad"><%= err %></p><% } %>
  <input name="full_name" value="<%= v.full_name||'' %>" placeholder="Full name" required>
  <input name="student_code" value="<%= v.student_code||'' %>" placeholder="Student ID" required>
  <input name="email" type="email" value="<%= v.email||'' %>" placeholder="Email" required>
  <input name="class_name" value="<%= v.class_name||'' %>" placeholder="Class" required>
  <button class="btn pink pop">Submit</button>
</form>
<%- include('partials/foot') %>
