<%- include('partials/head') %>
<h2 class="bubble s" data-bubble="Students"></h2>
<% if (ok) { %><p class="toast">You're registered! Your name is now on the list.</p><% } %>

<form class="controls" id="filterForm" method="get" action="/students">
  <div class="search">
    <input name="q" value="<%= s %>" placeholder="Search by name / student id / class">
    <button class="btn sun pop">Search</button>

    <div class="dd" data-dd>
      <button type="button" class="btn mint dd-btn" aria-haspopup="true" aria-expanded="false">
        Filter<span class="dd-badge" <%- cls ? '' : 'hidden' %>>1</span><i aria-hidden="true">▾</i>
      </button>
      <div class="dd-menu" role="group" aria-label="Filter by class" hidden>
        <p class="dd-title">Class</p>
        <label class="dd-item"><input type="radio" name="class" value="" <%= !cls ? 'checked' : '' %>><span>All classes</span></label>
        <% classes.forEach(c => { %>
          <label class="dd-item"><input type="radio" name="class" value="<%= c %>" <%= cls === c ? 'checked' : '' %>><span><%= c %></span></label>
        <% }) %>
        <button class="btn mint dd-apply">Apply</button>
      </div>
    </div>

    <div class="dd" data-dd>
      <button type="button" class="btn pink dd-btn" aria-haspopup="true" aria-expanded="false">
        Sort<span class="dd-badge" <%- sortCount ? '' : 'hidden' %>><%= sortCount %></span><i aria-hidden="true">▾</i>
      </button>
      <div class="dd-menu right" role="group" aria-label="Sort" hidden>
        <p class="dd-title">Sort by</p>
        <label class="dd-item"><input type="checkbox" name="sort" value="id" data-count <%= sortId ? 'checked' : '' %>><span>Student ID</span></label>
        <label class="dd-item"><input type="checkbox" name="sort" value="name" data-count <%= sortName ? 'checked' : '' %>><span>Name</span></label>
        <p class="dd-title">Order</p>
        <label class="dd-item"><input type="radio" name="order" value="asc" <%= order === 'asc' ? 'checked' : '' %>><span>A → Z</span></label>
        <label class="dd-item"><input type="radio" name="order" value="desc" <%= order === 'desc' ? 'checked' : '' %>><span>Z → A</span></label>
        <button class="btn pink dd-apply">Apply</button>
      </div>
    </div>
  </div>
</form>

<div class="result-bar" role="status" aria-live="polite">
  <span class="count-pill"><b><%= count %></b> <%= count === 1 ? 'result' : 'results' %> found</span>
  <% if (cls) { %><span class="tag">Class: <%= cls %></span><% } %>
  <% if (s) { %><span class="tag">Search: “<%= s %>”</span><% } %>
  <% if (sortCount) { %><span class="tag">Sorted by <%= [sortId && 'Student ID', sortName && 'Name'].filter(Boolean).join(' + ') %> (<%= order === 'desc' ? 'Z → A' : 'A → Z' %>)</span><% } %>
  <% if (hasFilter || sortCount) { %><a class="clear" href="/students">Clear all</a><% } %>
</div>

<section class="grid">
<% rows.forEach(r => { %>
  <a class="card tilt student" href="/students/<%= r.id %>">
    <h3><%= r.full_name %></h3><p><%= r.student_code %></p><span class="chip"><%= r.class_name %></span>
    <small>View profile →</small>
  </a>
<% }) %>
<% if (rows.length) for (let i = rows.length; i < 6; i++) { %><div class="card student fill" aria-hidden="true"></div><% } %>
</section>
<% if (!rows.length) { %>
  <% if (hasFilter) { %><p class="empty">No students match your filters.</p>
  <% } else { %><p class="empty">No students yet. <a href="/register">Be the first to register</a></p><% } %>
<% } %>
<% if (pages > 1) {
  const nums = [];
  for (let i = 1; i <= pages; i++) {
    if (i === 1 || i === pages || Math.abs(i - pageNo) <= 1) nums.push(i);
    else if (nums[nums.length - 1] !== '…') nums.push('…');
  }
%>
<nav class="pager-nav" aria-label="Pages">
  <% if (pageNo > 1) { %><a class="pg" href="/students?<%= baseQs %>page=<%= pageNo - 1 %>" aria-label="Previous page">‹</a><% } else { %><span class="pg off">‹</span><% } %>
  <% nums.forEach(n => { %>
    <% if (n === '…') { %><span class="pg gap">…</span>
    <% } else { %><a class="pg <%= n === pageNo ? 'on' : '' %>" href="/students?<%= baseQs %>page=<%= n %>"><%= n %></a><% } %>
  <% }) %>
  <% if (pageNo < pages) { %><a class="pg" href="/students?<%= baseQs %>page=<%= pageNo + 1 %>" aria-label="Next page">›</a><% } else { %><span class="pg off">›</span><% } %>
</nav>
<% } %>
<%- include('partials/foot') %>
