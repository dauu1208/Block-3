<%- include('partials/head') %>
<section class="hero">
  <p class="chip">Our little classroom</p>
  <h1 class="bubble" data-bubble="Twinkle"></h1>
  <p class="sub"><b><%= total %></b> <%= total === 1 ? 'friend has' : 'friends have' %> joined. Let's soar high together!</p>
  <div class="actions">
    <a href="/register" class="btn pink pop">Sign up now</a>
    <a href="/students" class="btn mint pop">View the list</a>
  </div>
  <div class="piano-wrap">
    <i class="pstar" style="--c:#ffd23f;--z:34px;left:-2%;top:-4px;animation-delay:0s"></i>
    <i class="pstar" style="--c:#ff8fc7;--z:22px;left:10%;top:-34px;animation-delay:0.6s"></i>
    <i class="pstar" style="--c:#5be0a0;--z:26px;left:86%;top:-30px;animation-delay:1.1s"></i>
    <i class="pstar" style="--c:#ffb454;--z:36px;left:98%;top:20px;animation-delay:0.3s"></i>
    <i class="pstar" style="--c:#fff;--z:20px;left:-6%;top:90px;animation-delay:0.9s"></i>
    <i class="pstar" style="--c:#8d8bff;--z:24px;left:104%;top:110px;animation-delay:1.4s"></i>
    <span class="note n1" aria-hidden="true">♪</span><span class="note n2" aria-hidden="true">♫</span>
    <div class="piano" role="group" aria-label="Little piano — tap the keys to play">
      <span class="piano-label">♪ Twinkle Piano ♪</span>
      <div class="keys-bed"><div class="keys">
      <button type="button" class="key w pop" style="--c:#5aa9ff" data-note="261.63" aria-label="Piano key C"></button>
      <button type="button" class="key w pop" style="--c:#ff8fc7" data-note="293.66" aria-label="Piano key D"></button>
      <button type="button" class="key w pop" style="--c:#ffb454" data-note="329.63" aria-label="Piano key E"></button>
      <button type="button" class="key w pop" style="--c:#5be0a0" data-note="349.23" aria-label="Piano key F"></button>
      <button type="button" class="key w pop" style="--c:#8d8bff" data-note="392.0" aria-label="Piano key G"></button>
      <button type="button" class="key w pop" style="--c:#ff6f91" data-note="440.0" aria-label="Piano key A"></button>
      <button type="button" class="key w pop" style="--c:#5be0a0" data-note="493.88" aria-label="Piano key B"></button>
      <button type="button" class="key w pop" style="--c:#5aa9ff" data-note="523.25" aria-label="Piano key C"></button>
      <button type="button" class="key b pop" style="--k:1" data-note="277.18" aria-label="Piano key C#"></button>
      <button type="button" class="key b pop" style="--k:2" data-note="311.13" aria-label="Piano key D#"></button>
      <button type="button" class="key b pop" style="--k:4" data-note="369.99" aria-label="Piano key F#"></button>
      <button type="button" class="key b pop" style="--k:5" data-note="415.3" aria-label="Piano key G#"></button>
      <button type="button" class="key b pop" style="--k:6" data-note="466.16" aria-label="Piano key A#"></button>
      </div></div>
    </div>
    <p class="piano-hint">Tap the keys and play a song!</p>
  </div>
</section>
<%- include('partials/foot') %>
